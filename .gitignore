# ROS2 colcon 빌드 산출물
**/build/
**/install/
**/log/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 에디터
.vscode/
.idea/
*.sw[op]

# Claude Code 로컬 전용 설정
.claude/settings.local.json

# Claude Code 스킬 (개인용, 팀 공유 안 함)
.claude/skills/

# Claude Code 대화 기록 (개인용, 팀 공유 안 함)
chat_log/

# tune.sh 로컬 상태 (튜닝 이력 · --undo 용 백업)
.tune_history
.tune_backup.yaml

# 외부 최적화 도구 (로컬 클론)
forza_traj_opt/
global_racetrajectory_optimization/

# 실차 주행 로그
logs/

# sim.sh 자동 생성 심링크
f1TENTH-contest_full_stack/sim_ws/src/f1tenth_gym_ros/maps/*_waypoints.csv

# ★ 차량별 캘리브레이션 — 절대 커밋하지 않는다
#   config/vesc.yaml 은 config/vesc_base.yaml + config/vehicle_<차>.yaml 에서
#   apply_vehicle.py 가 매 실행마다 생성한다. git 에 두면 2호차의 음수
#   speed_to_erpm_gain 이 1호차로 넘어가 차가 후진한다 — 추적 대상에서 뺀다.
config/vesc.yaml
config/.vehicle_overlay.yaml
.car
